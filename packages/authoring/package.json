{
  "name": "@repo/authoring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./Build": "./src/Build.ts",
    "./Define": "./src/Define.ts",
    "./Official": "./src/Official.ts",
    "./Template": "./src/Template.ts",
    "./internal/*": null
  },
  "scripts": {
    "type-check": "tsc --noEmit",
    "test": "vitest run --exclude '**/.stryker-tmp/**'",
    "test:mutation": "stryker run",
    "clean": "git clean -xdf .cache .turbo dist node_modules tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@repo/catalog": "workspace:*",
    "@repo/domain": "workspace:*",
    "effect": "4.1.6"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.6",
    "@effect/vitest": "4.1.6",
    "@repo/config-typescript": "workspace:*",
    "@types/node": "^26.6.6",
    "vitest": "^5.1.0"
  }
}
