{
  "$schema": "../../node_modules/@effect/tsgo/schema.json",
  "display": "Default",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "module": "ESNext",
    "target": "esnext",
    "lib": ["ESNext"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "preserveWatchOutput": true,
    "removeComments": false,
    "sourceMap": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "barrelImportPackages": ["effect"],
        "effectFn": ["span"],
        "includeSuggestionsInTsc": true,
        "layerGraphFollowDepth": 1,
        "noExternal": true,
        "quickinfoMaximumLength": 1200,
        "diagnosticSeverity": {
          "cryptoRandomUUIDInEffect": "suggestion",
          "globalDateInEffect": "suggestion",
          "layerMergeAllWithDependencies": "warning",
          "missingEffectServiceDependency": "warning",
          "schemaNumber": "warning",
          "schemaSyncInEffect": "warning"
        },
        "overrides": [
          {
            "include": ["**/*.test.ts", "**/*.test.tsx"],
            "options": {
              "diagnosticSeverity": {
                "globalErrorInEffectFailure": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
