{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    ".reference/**",
    "workspace/**",
    "catalogs/**/templates/**",
    "apps/docs/app/content/reference/cli/**"
  ],
  "production": {
    "ignore": ["**/test/**", "**/e2e/**"]
  },
  "publicPackages": ["@stack-effect/author", "@repo/authoring"],
  "ignoreExports": [
    {
      "file": "apps/docs/app/components/ui/**",
      "exports": ["*"]
    }
  ],
  "usedClassMembers": [
    "message",
    "toSorted",
    "toPath",
    "toPackageName",
    "withCatalogs",
    "packageManagerSpec",
    "workspaceDependency"
  ],
  "ignoreDependencies": ["@effect/language-service"]
}
