{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": { "newlinesBetween": false },
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.cache/**",
    "**/.turbo/**",
    ".reference/**",
    ".okf/**",
    "**/*.md",
    "**/*.mdx",
    "**/*.html",
    // Template and golden bytes are embedded verbatim in catalog JSON.
    "packages/authoring/test/fixtures/**/templates/**",
    "packages/authoring/test/fixtures/invalid/**",
    "packages/authoring/test/fixtures/**/golden/**",
    "catalogs/**/templates/**",
    "catalogs/**/*.golden.json",
  ],
}
