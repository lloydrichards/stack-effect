{
  "name": "{{packageName}}",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "{{runtime}} scripts/build.ts",
    "validate": "{{runtime}} scripts/validate.ts",
    "preview": "{{runtime}} scripts/preview.ts",
    "type-check": "tsc --noEmit",
    "clean": "git clean -xdf .turbo dist node_modules tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "{{#if runtime=bun}}@effect/platform-bun{{/if}}{{#if runtime=node}}@effect/platform-node{{/if}}": "4.0.0-rc.117",
    "@stack-effect/author": "~0.1.0",
    "effect": "4.0.0-rc.117"
  },
  "devDependencies": {
    "@repo/config-typescript": "{{workspaceDependency}}",
    {{#if runtime=bun}}"@types/bun": "^1.2.17",{{/if}}{{#if runtime=node}}"@types/node": "^24.0.0",{{/if}}
    "stack-effect": "~0.16.0"
  }
}
