// oxfmt uses the nearest config without merging, so this repeats the
// workspace options and also skips template files, which the catalog embeds
// byte for byte.
{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/generated/**",
    "**/.cache/**",
    "**/.turbo/**",
    "templates/**",
  ],
}
