{
  "$schema": "{{#if typescript=6}}../../node_modules/@effect/language-service/schema.json{{/if}}{{#if typescript=7}}../../node_modules/@effect/tsgo/schema.json{{/if}}",
  "display": "Default",
  "compilerOptions": {
    "moduleResolution": "bundler",
    {{#if runtime=deno}}"preserveSymlinks": true,
    {{/if}}
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2023"{{#if runtime=deno}}, "DOM"{{/if}}],
    {{#if runtime=deno}}"types": ["deno", "node"],
    {{/if}}
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": false,
    "preserveWatchOutput": true,
    "removeComments": false,
    "sourceMap": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "barrelImportPackages": ["effect"],
        {{#if typescript=7}}"ignoreEffectSuggestionsInTscExitCode": true,
        "ignoreEffectWarningsInTscExitCode": true,
        "allowedUnstableApis": [
          "@effect/ai-anthropic/AnthropicClient",
          "@effect/ai-anthropic/AnthropicLanguageModel",
          "@effect/atom-react/Hooks",
          "@effect/platform-browser/BrowserSocket",
          "@effect/platform-browser/BrowserWorker",
          "@effect/platform-browser/BrowserWorkerRunner",
          "@effect/platform-bun/BunFileSystem",
          "@effect/platform-bun/BunHttpServer",
          "@effect/platform-bun/BunPath",
          "@effect/platform-bun/BunRuntime",
          "@effect/platform-bun/BunServices",
          "@effect/platform-deno",
          "@effect/platform-node",
          "@effect/platform-node-shared/NodeCrypto",
          "@effect/sql-pg",
          "@effect/sql-sqlite-bun/SqliteClient",
          "@effect/sql-sqlite-bun/SqliteMigrator",
          "@effect/sql-sqlite-node",
          "effect/FileSystem",
          "effect/Path",
          "effect/PlatformError",
          "effect/Stdio",
          "effect/Terminal",
          "effect/ai/Chat",
          "effect/ai/LanguageModel",
          "effect/ai/McpProtocol",
          "effect/ai/McpServer",
          "effect/ai/Prompt",
          "effect/ai/Response",
          "effect/ai/Tool",
          "effect/ai/Toolkit",
          "effect/cli/Argument",
          "effect/cli/Command",
          "effect/cli/Flag",
          "effect/cli/Prompt",
          "effect/crypto/SecureRandom",
          "effect/devtools/DevTools",
          "effect/http-api/HttpApi",
          "effect/http-api/HttpApiBuilder",
          "effect/http-api/HttpApiClient",
          "effect/http-api/HttpApiEndpoint",
          "effect/http-api/HttpApiGroup",
          "effect/http-api/HttpApiSchema",
          "effect/http/FetchHttpClient",
          "effect/http/HttpClient",
          "effect/http/HttpClientRequest",
          "effect/http/HttpClientResponse",
          "effect/http/HttpRouter",
          "effect/http/HttpServer",
          "effect/reactivity/AsyncResult",
          "effect/reactivity/Atom",
          "effect/reactivity/AtomRpc",
          "effect/rpc/Rpc",
          "effect/rpc/RpcClient",
          "effect/rpc/RpcClientError",
          "effect/rpc/RpcGroup",
          "effect/rpc/RpcSerialization",
          "effect/rpc/RpcServer",
          "effect/sql/SqlClient"
        ],
        "allowedExperimentalApis": [
          "effect/ai/McpClient",
          "effect/ai/McpClientError"
        ],
        {{/if}}"includeSuggestionsInTsc": true{{#if typescript=6}},
        "quickinfoMaximumLength": 1200{{/if}},
        "diagnosticSeverity": {
          "abortControllerInEffect": "warning",
          "asyncFunction": "warning",
          "cryptoRandomUUID": "warning",
          "cryptoRandomUUIDInEffect": "warning",
          "extendsNativeError": "warning",
          "globalConsole": "warning",
          "globalConsoleInEffect": "warning",
          "globalDate": "warning",
          "globalDateInEffect": "warning",
          "globalFetch": "warning",
          "globalFetchInEffect": "warning",
          "globalRandom": "warning",
          "globalRandomInEffect": "warning",
          "globalTimers": "warning",
          "globalTimersInEffect": "warning",
          "instanceOfSchema": "warning",
          "layerMergeAllWithDependencies": "warning",
          "missingEffectServiceDependency": "warning",
          "newPromise": "warning",
          "nodeBuiltinImport": "warning",
          {{#if typescript=6}}"preferSchemaOverJson": "warning"{{/if}}{{#if typescript=7}}"globalJson": "warning",
          "globalJsonInEffect": "warning"{{/if}},
          "processEnv": "warning",
          "processEnvInEffect": "warning",
          {{#if typescript=7}}"schemaNumber": "warning",
          "schemaSyncInEffect": "warning",
          {{/if}}"unsafeEffectTypeAssertion": "warning"
        },
        "overrides": [
          {
            "include": [
              "**/*.test.ts",
              "**/*.test.tsx"
            ],
            "options": {
              "diagnosticSeverity": {
                "asyncFunction": "off",
                "nodeBuiltinImport": "off",
                {{#if typescript=6}}"preferSchemaOverJson": "off"{{/if}}{{#if typescript=7}}"globalJson": "off",
                "globalJsonInEffect": "off"{{/if}}
              }
            }
          }
        ]
      }
    ]
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}
