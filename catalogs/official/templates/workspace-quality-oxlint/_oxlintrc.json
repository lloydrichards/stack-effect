{{#if typescript=6}}{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "denyWarnings": true
  },
  "rules": {
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 4],
    "no-nested-ternary": "error",
    "typescript/array-type": [
      "error",
      { "default": "generic", "readonly": "generic" }
    ],
    "unicorn/prefer-array-flat-map": "error"
  }
}{{/if}}{{#if effectOxlint}}{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/recommended.json",
    "./node_modules/@effect/tsgo/oxlint-presets/effect-native.json",
    "./node_modules/@effect/tsgo/oxlint-presets/strict.json"
  ],
  "options": {
    "denyWarnings": false
  },
  "rules": {
    "max-depth": ["error", 3],
    "max-nested-callbacks": ["error", 4],
    "no-nested-ternary": "error",
    "typescript/array-type": [
      "error",
      { "default": "generic", "readonly": "generic" }
    ],
    "unicorn/prefer-array-flat-map": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx"
      ],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/global-json": "off",
        "effecttsgo/global-json-in-effect": "off"
      }
    }
  ]
}{{/if}}
