{{#if typescript=6}}{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "denyWarnings": true
  }
}{{/if}}{{#if effectOxlint}}{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": [
    "./node_modules/@effect/tsgo/oxlint-presets/recommended.json",
    "./node_modules/@effect/tsgo/oxlint-presets/effect-native.json"
  ],
  "options": {
    "denyWarnings": true
  },
  "rules": {
    "effecttsgo/unstable-api-usage": "off",
    "effecttsgo/experimental-api-usage": "off",
    "effecttsgo/schema-class-missing-brand": "off",
    "effecttsgo/prefer-effect-array": "off",
    "effecttsgo/prefer-effect-string": "off",
    "effecttsgo/prefer-effect-record": "off",
    "effecttsgo/option-match-to-from-option": "off",
    "effecttsgo/all-of-map-to-for-each": "off"
  },
  "overrides": [
    {
      "files": [
        "**/src/components/rest-card.tsx",
        "**/src/components/chat-box.tsx",
        "**/src/features/rest.ts",
        "**/src/features/chat.ts"
      ],
      "rules": {
        "effecttsgo/global-json": "off",
        "effecttsgo/schema-sync": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/global-json": "off",
        "effecttsgo/global-json-in-effect": "off"
      }
    }
  ]
}{{/if}}
