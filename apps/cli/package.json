{
  "name": "stack-effect",
  "version": "0.19.0",
  "description": "Scaffolding CLI for full-stack TypeScript apps built on Effect",
  "license": "MIT",
  "type": "module",
  "bin": {
    "stack-effect": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/lloydrichards/stack-effect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lloydrichards/stack-effect.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/lloydrichards/stack-effect/issues"
  },
  "keywords": [
    "effect",
    "typescript",
    "scaffolding",
    "cli",
    "fullstack"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=node --minify --banner '#!/usr/bin/env node' && mkdir -p dist/skills/stack-effect && cp src/skills/stack-effect/SKILL.md dist/skills/stack-effect/SKILL.md",
    "build:types": "tsc --emitDeclarationOnly",
    "docs:generate": "bun run scripts/generate-cli-reference.ts",
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "vitest run src",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "type-check": "tsc --noEmit",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "verify:create-path": "bun scripts/verify-create-path.ts",
    "verify:library": "bun scripts/verify-library.ts"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.1.4",
    "@effect/platform-node": "4.1.4",
    "@effect/vitest": "4.1.4",
    "@repo/catalog": "workspace:*",
    "@repo/catalog-author": "workspace:*",
    "@repo/catalog-official": "workspace:*",
    "@repo/config-typescript": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/scaffold": "workspace:*",
    "@repo/tui": "workspace:*",
    "@types/bun": "1.4.4",
    "effect": "4.1.4",
    "effect-boxes": "^0.18.1",
    "vitest": "^5.1.0"
  }
}
