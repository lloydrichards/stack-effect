    "@react-router/serve": "8.3.0",
    "@repo/catalog": "workspace:*",
    "@repo/domain": "workspace:*",
    "@repo/scaffold": "workspace:*",
    "@shikijs/transformers": "^4.2.0",
    "@standard-schema/spec": "^1.1.0",
    "@tanstack/react-form": "^1.33.4",
    "@tanstack/store": "^0.11.1",
