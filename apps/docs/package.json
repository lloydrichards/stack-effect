{
  "name": "@stack-effect/docs",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "clean": "rm -rf build node_modules .turbo .react-router tsconfig.tsbuildinfo",
    "dev": "bun run --cwd ../cli docs:generate && react-router dev",
    "lint": "biome lint .",
    "prebuild": "bun run --cwd ../cli docs:generate",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "test:browser": "vitest run --project=browser",
    "test:watch": "vitest",
    "type-check": "react-router typegen && tsc"
  },
