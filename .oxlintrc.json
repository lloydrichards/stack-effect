{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "rules": {
    "eslint/require-yield": "off",
    "effecttsgo/unnecessary-typeof-type": "off",
    "typescript/consistent-type-definitions": ["error", "type"],
    "oxc/no-barrel-file": "error",
    "func-style": ["error", "expression"],
    "typescript/no-non-null-assertion": "error"
  },
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/consistent-type-definitions": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "effecttsgo/async-function": "off",
        "effecttsgo/node-builtin-import": "off",
        "effecttsgo/global-json": "off",
        "effecttsgo/global-json-in-effect": "off"
      }
    },
    {
      "files": ["packages/authoring/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "bun",
                  "bun:*",
                  "@effect/platform-*",
                  "assert",
                  "buffer",
                  "child_process",
                  "crypto",
                  "events",
                  "fs",
                  "fs/*",
                  "module",
                  "os",
                  "path",
                  "path/*",
                  "process",
                  "stream",
                  "url",
                  "util",
                  "worker_threads"
                ],
                "message": "Authoring runs on Bun, Node and Deno; use Effect platform services."
              }
            ]
          }
        ],
        "no-restricted-globals": [
          "error",
          {
            "name": "Bun",
            "message": "Authoring runs on Bun, Node and Deno; use Effect platform services."
          },
          {
            "name": "Deno",
            "message": "Authoring runs on Bun, Node and Deno; use Effect platform services."
          },
          {
            "name": "process",
            "message": "Authoring runs on Bun, Node and Deno; use Effect platform services."
          }
        ]
      }
    },
    {
      "files": ["packages/authoring/src/**/*.test.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    },
    {
      "files": ["**/test/**/*.ts", "**/*.test.ts", "**/*.test.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/internal/*"],
                "message": "Tests import public modules only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/scaffold/test/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "vitest",
                "message": "Import test helpers from @effect/vitest."
              },
              {
                "name": "node:assert",
                "message": "Use assert from @effect/vitest."
              },
              {
                "name": "node:assert/strict",
                "message": "Use assert from @effect/vitest."
              }
            ],
            "patterns": [
              {
                "group": ["**/internal/*"],
                "message": "Tests import public modules only."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": [
    ".claude/worktrees/**",
    "packages/authoring/test/fixtures/**/templates/**",
    "catalogs/**/templates/**"
  ]
}
